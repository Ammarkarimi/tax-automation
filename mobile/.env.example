# URL of the TaxPilot backend as seen FROM THE DEVICE/EMULATOR.
#  - iOS simulator:      http://localhost:8000
#  - Android emulator:   http://10.0.2.2:8000
#  - Physical phone:     http://<your-computer-LAN-IP>:8000  (or https:// with the dev cert)
# Copy to `.env.local` (git-ignored). Expo inlines EXPO_PUBLIC_* vars at build time,
# so never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8000
