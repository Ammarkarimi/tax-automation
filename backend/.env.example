# ---------------------------------------------------------------------------
# TaxPilot backend configuration (local development).
# Copy to `.env` and fill in values. NEVER commit the real `.env`.
# Generate secrets with:  python scripts/generate_secrets.py
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# PostgreSQL (see docker-compose.yml at repo root, or a local install)
DATABASE_URL=postgresql+psycopg://taxpilot:taxpilot@localhost:5432/taxpilot

# --- Secrets (REQUIRED; generate, don't invent) ---
JWT_SECRET=change-me-generate-with-scripts-generate_secrets
# 32 random bytes, urlsafe-base64 encoded. Encrypts uploaded files + PII columns.
DATA_ENCRYPTION_KEY=change-me-generate-with-scripts-generate_secrets
# Separate key used to HMAC one-time passwords and refresh tokens.
HMAC_SECRET=change-me-generate-with-scripts-generate_secrets

# --- OpenAI (optional: without it the app falls back to rule-based logic) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Strip SSNs/EINs/account numbers/emails/phones before sending text to OpenAI
AI_REDACT_PII=true

# --- Email OTP ---
# "console" prints OTP emails to the server log (dev only); "smtp" sends them.
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=TaxPilot <no-reply@taxpilot.local>

# --- Web ---
CORS_ORIGINS=http://localhost:5173,https://localhost:5173
# Set true when serving over HTTPS (scripts/gen-dev-cert.sh) so cookies get `Secure`
COOKIE_SECURE=false

# Where encrypted uploads and generated PDFs live
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15

# Bootstrap an admin account on first start (optional)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
